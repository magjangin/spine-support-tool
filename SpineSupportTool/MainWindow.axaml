<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SpineSupportTool.Models"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
        x:Class="SpineSupportTool.MainWindow"
        Title="Spine Support Tool - Muse Dash &amp; Spine 3.8 Workstation"
        Width="1200" Height="820"
        MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4C6EF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#2B8A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto, 170">
        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Spine Support Tool" FontSize="20" FontWeight="Bold" Foreground="#4C6EF5" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0 (Muse Dash &amp; Spine 3.8 Workstation)" FontSize="13" Opacity="0.6" VerticalAlignment="Center" Margin="5,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnOpenViewerTop" Content="🎮 SpineViewer 실행" Click="OnLaunchViewerClick"/>
                    <Button Name="BtnOpenOutputDirTop" Content="📁 작업 폴더 열기" Click="OnOpenWorkDirClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 탭 콘텐츠 -->
        <TabControl Grid.Row="1" Margin="12,4,12,0">
            <!-- 탭 1: spine-hwa 관리자 -->
            <TabItem Header="🛠️ spine-hwa 관리">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <!-- 상태 카드 -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="spine-hwa 도구 연동 상태" Classes="header"/>
                                
                                <Grid ColumnDefinitions="180, *" RowDefinitions="Auto, Auto, Auto" Margin="4,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="• SpineViewer (GUI):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtViewerStatus" Text="확인 중..." VerticalAlignment="Center" Margin="0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="• sv-cli (배치 렌더러):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtCliStatus" Text="확인 중..." VerticalAlignment="Center" Margin="0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="• 로컬 Rust 소스코드:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtSourceStatus" Text="확인 중..." VerticalAlignment="Center" Margin="0,3"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button Content="상태 새로고침" Click="OnRefreshStatusClick"/>
                                    <Button Classes="primary" Content="🎮 SpineViewer.exe 실행" Click="OnLaunchViewerClick"/>
                                    <Button Content="sv-cli 테스트 (도움말 출력)" Click="OnTestCliClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 설치 및 빌드 카드 -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="설치 및 원클릭 빌드" Classes="header"/>
                                <TextBlock Text="GitHub 최신 Release 다운로드 또는 로컬 소스 원클릭 릴리즈 컴파일을 지원합니다." Classes="sub"/>
                                
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4">
                                    <TextBlock Text="GitHub 저장소 URL:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Name="TxtGithubUrl" Text="https://github.com/magjangin/spine-hwa"/>
                                    <Button Grid.Column="2" Classes="primary" Content="릴리즈 ZIP 다운로드 &amp; 설치" Margin="10,0,0,0" Click="OnDownloadReleaseClick"/>
                                </Grid>

                                <Separator Margin="0,6"/>

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="로컬 소스 원클릭 릴리즈 컴파일 (dist.ps1)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Rust와 MSVC 빌드 도구를 사용하여 bin/ 폴더로 SpineViewer와 sv-cli를 즉시 컴파일 배포합니다." Classes="sub"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="success" Content="🔨 로컬 빌드 시작 (dist.ps1)" VerticalAlignment="Center" Click="OnBuildLocalClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: 뮤즈대쉬 번들 추출 -->
            <TabItem Header="📦 번들 추출">
                <Grid RowDefinitions="Auto, *, Auto" Margin="0,8,0,0">
                    <Border Grid.Row="0" Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="뮤즈대쉬 gamescene 에셋 번들 추출" Classes="header"/>
                                <TextBlock Text="StreamingAssets의 gamescene_*.bundle 파일에서 .skel, .atlas, .png를 한 번에 추출합니다." Classes="sub"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="번들 목록 새로고침" Click="OnRefreshBundlesClick"/>
                                <Button Content="장면 01~12 선택" Click="OnSelectMainScenesClick"/>
                                <Button Content="전체 선택" Click="OnSelectAllBundlesClick"/>
                                <Button Content="선택 해제" Click="OnDeselectAllBundlesClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 번들 목록 -->
                    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <ListBox Name="LstBundles">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:BundleItem">
                                    <Grid ColumnDefinitions="Auto, 110, *, 100" Margin="4,2">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#224C6EF5" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SceneTag}" FontWeight="Bold" Foreground="#4C6EF5"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding FileName}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding FileSizeFormatted}" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 하단 추출 실행 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="추출 대상 폴더:" FontWeight="SemiBold"/>
                            <TextBlock Name="TxtBundleTargetDir" Text="-" Opacity="0.7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="📁 추출 폴더 열기" Click="OnOpenExtractedDirClick"/>
                            <Button Classes="primary" Content="🚀 선택한 번들 일괄 추출 시작" Click="OnStartExtractBundlesClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 탭 3: 몬스터/노트 배치 렌더 -->
            <TabItem Header="🎨 몬스터/노트 렌더">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Spine 3.8 고속 배치 렌더러 (sv-cli)" Classes="header"/>
                                <TextBlock Text="추출된 스켈레톤(.skel)과 아틀라스(.atlas)를 바탕으로 투명 PNG 노트를 자동으로 일괄 렌더링합니다." Classes="sub"/>

                                <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="입력 폴더:" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,3">
                                        <TextBox Name="TxtRenderInputDir" Text=""/>
                                        <Button Grid.Column="1" Content="찾기..." Margin="6,0,0,0" Click="OnBrowseRenderInputDirClick"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="출력 폴더:" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,3">
                                        <TextBox Name="TxtRenderOutputDir" Text=""/>
                                        <Button Grid.Column="1" Content="찾기..." Margin="6,0,0,0" Click="OnBrowseRenderOutputDirClick"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="렌더링 배율 (Scale):" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,3">
                                        <ComboBox Name="CmbScale" SelectedIndex="0" Width="170">
                                            <ComboBoxItem Content="0.5 (뮤즈대쉬 표준)"/>
                                            <ComboBoxItem Content="1.0 (원본 원시 크기)"/>
                                            <ComboBoxItem Content="0.25 (소형 프리뷰)"/>
                                        </ComboBox>
                                        <TextBlock Text="※ 뮤즈대쉬 인게임 몬스터 및 BMS 에디터 스킨은 0.5 배율이 기본 규격입니다." Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="스킨 옵션 (Skin):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Name="TxtRenderSkin" Text="all" Margin="0,3"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Classes="primary" Content="⚡ 몬스터/노트 일괄 렌더링 시작" Click="OnStartBatchRenderClick"/>
                                    <Button Content="📁 렌더링 결과 폴더 열기" Click="OnOpenRenderOutputDirClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 4: BMS 노트 스킨 동기화 -->
            <TabItem Header="🎵 BMS 스킨 동기화">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="BMS 에디터 노트 스킨 규격 동기화" Classes="header"/>
                                <TextBlock Text="렌더링된 몬스터 이미지(air, road, 롱노트 등)를 BMS 에디터의 '장면NN/XXXX/' 폴더 규격으로 자동 배치합니다." Classes="sub"/>

                                <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto" Margin="0,4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="렌더 소스 폴더:" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,3">
                                        <TextBox Name="TxtBmsSourceDir" Text=""/>
                                        <Button Grid.Column="1" Content="찾기..." Margin="6,0,0,0" Click="OnBrowseBmsSourceDirClick"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BMS 스킨 폴더:" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,3">
                                        <TextBox Name="TxtBmsTargetDir" Text=""/>
                                        <Button Grid.Column="1" Content="찾기..." Margin="6,0,0,0" Click="OnBrowseBmsTargetDirClick"/>
                                    </Grid>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Classes="success" Content="📂 BMS 에디터 규격으로 자동 동기화" Click="OnSyncBmsClick"/>
                                    <Button Content="📁 BMS 스킨 폴더 열기" Click="OnOpenBmsDirClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 5: 환경 설정 -->
            <TabItem Header="⚙️ 환경 설정">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="도구 및 작업 경로 설정" Classes="header"/>

                                <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="0,4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="뮤즈대쉬 설치 경로:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="CfgMuseDashPath" Margin="0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="AssetStudio CLI 경로:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Name="CfgAssetStudioCli" Margin="0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="spine-hwa 프로젝트 경로:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Name="CfgSpineHwaPath" Margin="0,3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="작업 기본 출력 폴더:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Name="CfgWorkOutputDir" Margin="0,3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="BMS 에디터 노트 스킨:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Name="CfgBmsNoteSkinDir" Margin="0,3"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Classes="primary" Content="💾 설정 저장" Click="OnSaveConfigClick"/>
                                    <Button Content="기본값 복원" Click="OnResetConfigClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Name="TxtStatusBar" Text="준비 완료" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Name="TxtStatusDetail" Text="" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Name="PnlProgress" IsVisible="False">
                    <ProgressBar Name="PrgTask" Minimum="0" Maximum="100" Value="0" Width="220" Height="16" VerticalAlignment="Center" CornerRadius="4"/>
                    <TextBlock Name="TxtProgressPercent" Text="0.0%" FontWeight="Bold" Width="55" TextAlignment="Right" VerticalAlignment="Center" Foreground="#4C6EF5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 하단 실시간 콘솔 로그 -->
        <Grid Grid.Row="3" RowDefinitions="Auto, *">
            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" Padding="12,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="📋 작업 로그 (Log Console)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="로그 지우기" FontSize="11" Padding="8,2" Click="OnClearLogClick"/>
                </Grid>
            </Border>
            <TextBox Grid.Row="1" Name="TxtLogConsole" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Background="#141414" Foreground="#D4D4D4" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
